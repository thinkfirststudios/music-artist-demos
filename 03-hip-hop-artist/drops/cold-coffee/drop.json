  "lyrics": [
    {
      "tag": "VERSE 1",
      "lines": [
        "Cold coffee on the dash since six,",
        "keep meaning to drink it, never do, it's a fixture now,",
        "like the rosary on the mirror and the parking stub from May,",
        "like the voicemail from my sister that I never erase."
      ]
    },
    {
      "tag": "HOOK",
      "lines": [
        "Cold coffee, warm heart, long road,",
        "everything I own is in the passenger seat, so,",
        "cold coffee, still here, still going,",
        "nobody said that it'd be good, just that it would be morning."
      ]
    },
    {
      "tag": "VERSE 2",
      "lines": [
        "Rehearsal in the room off Telephone Road,",
        "Theo counting in, Nadia finding the chord nobody wrote,",
        "we play it till it's ugly, then we play it till it's right,",
        "then I drive home with the coffee I forgot again tonight."
      ]
    },
    {
      "tag": "HOOK",
