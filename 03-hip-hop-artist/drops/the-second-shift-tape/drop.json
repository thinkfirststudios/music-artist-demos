      "lyrics": [
        {
          "tag": "VERSE 1",
          "lines": [
            "Second shift, second wind, second hand on the clock,",
            "second job, second guess, second time that I stop",
            "at the light on Lockwood where the preacher's got a stand,",
            "selling mangos and salvation for whatever's in your hand."
          ]
        },
        {
          "tag": "HOOK",
          "lines": [
            "Second shift, I'm on the second shift,",
            "the first one's for the rent, the second one's for this,",
            "second shift, the song is what is left,",
            "the first one takes the body, second one takes the breath."
          ]
        },
        {
          "tag": "VERSE 2",
          "lines": [
            "Home at a quarter to midnight, Mama left the light on,",
            "plate in the microwave, a note that says you're right on,",
            "I don't know what I was right on, and she didn't say,",
            "but I kept the note, it's folded in the liner of the tape."
          ]
        },
