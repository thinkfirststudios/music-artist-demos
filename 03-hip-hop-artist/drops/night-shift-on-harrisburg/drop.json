  "lyrics": [
    {
      "tag": "VERSE 1",
      "lines": [
        "Harrisburg at two a.m., the laundromat's the only light,",
        "a man asleep inside his truck, a cat that owns the whole damn night,",
        "I'm on my second coffee and my third wind, fourth excuse,",
        "radio on dead air, the city talking to itself in blues."
      ]
    },
    {
      "tag": "HOOK",
      "lines": [
        "Night shift on Harrisburg, nobody sees you work,",
        "the city wakes up clean and never asks who moved the dirt,",
        "night shift on Harrisburg, the clock says almost free,",
        "sun comes up on the East End and it don't come up for me."
      ]
    },
    {
      "tag": "VERSE 2",
      "lines": [
        "Tamale lady packing up before the sun gets rude,",
        "I wave, she waves, that's the whole relationship, it's good,",
        "forty hours, forty minutes, forty years my father did it,",
        "I write it down so somebody remembers that he did it."
      ]
    },
    {
