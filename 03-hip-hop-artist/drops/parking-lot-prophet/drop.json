      "explicit": true,
      "lyrics": [
        {
          "tag": "VERSE 1",
          "lines": [
            "Man in the grocery lot preaching to the shopping carts,",
            "says the end is coming Thursday and it's coming for the parts,",
            "I bought the man a sandwich and he laid a hand on my car,",
            "said the brakes are gonna last and said I'm gonna go far."
          ]
        },
        {
          "tag": "HOOK",
          "lines": [
            "Parking lot prophet, tell me something I don't know,",
            "parking lot prophet, where the working people go,",
            "he don't need a pulpit, he got asphalt and a sign,",
            "parking lot prophet, and the brakes are doing fine."
          ]
        },
        {
          "tag": "VERSE 2",
          "lines": [
            "Six months later and the brakes are still good,",
            "I went back to tell him but he wasn't where he stood,",
            "nobody at the store could tell me where he went,",
            "so I made a song about it, that's the closest thing to rent."
          ]
        },
        {
