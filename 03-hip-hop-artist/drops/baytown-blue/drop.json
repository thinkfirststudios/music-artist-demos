  "lyrics": [
    {
      "tag": "VERSE 1",
      "lines": [
        "Refinery lit up like a birthday nobody came to,",
        "flare stacks burning off whatever's left of what we came through,",
        "Granddaddy worked the channel thirty-one years,",
        "came home smelling like the future with a ringing in his ears."
      ]
    },
    {
      "tag": "HOOK",
      "lines": [
        "Baytown blue, that's the colour of the water at dusk,",
        "Baytown blue, that's the colour of the paint on the truck,",
        "Baytown blue, that's the colour when I close my eyes,",
        "it ain't sad, it's just the colour of the sky."
      ]
    },
    {
      "tag": "VERSE 2",
      "lines": [
        "Forty minutes from the east side if the bridge is kind,",
        "I've written half my life inside that forty minutes' time,",
        "Mama on the porch, the dog that don't bark no more,",
        "I pull in, cut the engine, sit a minute, then I go in the door."
      ]
    },
